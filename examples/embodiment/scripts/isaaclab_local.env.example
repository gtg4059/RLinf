# Machine-local IsaacLab paths. Copy to isaaclab_local.env (gitignored) and
# edit. Already-exported values win when you keep the ${VAR:-} form.
#
#   cp examples/embodiment/scripts/isaaclab_local.env.example \
#      examples/embodiment/scripts/isaaclab_local.env
#
# Sourced by:
#   examples/embodiment/run_embodiment.sh
#   docker/run_embodied_isaaclab_blackwell.sh

# Isaac Sim 5.1.0 standalone tree (not in the Docker image).
# run_embodiment.sh reads ISAAC_PATH; the Docker wrapper reads ISAAC_SIM_PATH.
# The loader copies whichever one you set onto the other name.
ISAAC_SIM_PATH="${ISAAC_SIM_PATH:-/home/ubuntu/isaac_sim}"
# ISAAC_PATH="${ISAAC_PATH:-${ISAAC_SIM_PATH}}"

# Converted OpenPI CRI weights for cube→plate. Leave unset to auto-resolve
# checkpoint/pi05_droid_cri_rlinf_49999 then checkpoints/.
# CRI_OPENPI_CKPT="${CRI_OPENPI_CKPT:-}"

# Docker image used by run_embodied_isaaclab_blackwell.sh and by
# run_embodiment.sh when the host has no torch.
IMAGE_TAG="${IMAGE_TAG:-rlinf:embodied-isaaclab-blackwell}"

# Set to 1 on a native (non-Docker) install so run_embodiment.sh does not
# re-launch into IMAGE_TAG.
# RLINF_NO_DOCKER=1
